{{!-- Samurai tab. Context is prepared in CasusBelliActorSheet#_prepareSamuraiContext. --}}
<div class="samurai-tab-content">

  {{!-- ── Header: Arcane Might, Epiphanies, Retainers (centered) ── --}}
  <div class="samurai-header-row">
    <div class="miko-tile miko-tile-small">
      <label for="system.arcaneMight" class="resource-label rollable samurai-ability-roll" data-label="Samurai Ability" title="Samurai ability roll: Strength + Arcane Might">Arcane Might</label>
      <input type="text" name="system.arcaneMight" value="{{system.arcaneMight}}" data-dtype="Number"/>
    </div>

    <div class="miko-tile miko-tile-pair" title="Epiphanies needed to advance equal your current Arcane Might">
      <label for="system.ephiphanies.value" class="resource-label">Epiphanies</label>
      <div class="resource-content">
        <input type="text" name="system.ephiphanies.value" value="{{samurai.epiphanies.value}}" data-dtype="Number"/>
        <span>/</span>
        <input type="text" value="{{samurai.epiphanies.max}}" readonly/>
      </div>
    </div>

    {{#if samurai.hasRetainers}}
    <div class="miko-tile miko-tile-pair {{#if samurai.retainersOver}}samurai-over{{/if}}" title="Retainers sharing your Martial Spirit">
      <label for="system.retainers.value" class="resource-label">Retainers</label>
      <div class="resource-content">
        <input type="text" name="system.retainers.value" value="{{samurai.retainers.value}}" data-dtype="Number"/>
        <span>/</span>
        <input type="text" value="{{samurai.retainers.max}}" readonly/>
      </div>
    </div>
    {{/if}}
  </div>

  {{!-- ── Panels: body, Bushido, advancement ── --}}
  <div class="miko-panels">
    <div class="miko-panel">
      <h3>Oni's Might &amp; Steel Body</h3>
      <p class="samurai-stat" title="Not applied automatically: add it to your Strength and Endurance yourself"><strong>Oni's Might:</strong> +{{samurai.onisMight}} to Strength and Endurance (score and maximum)</p>
      <p class="samurai-stat"><strong>Natural armor:</strong> {{samurai.steelBody}} (Hard); +{{samurai.steelBodyArmored}} on armored locations</p>
      {{#if samurai.innerStrength}}<p class="samurai-stat"><strong>Inner Strength:</strong> +{{samurai.innerStrength}} maximum Stamina</p>{{/if}}
      {{#if samurai.feelNoPain}}<p class="samurai-stat"><strong>Feel No Pain:</strong> +{{samurai.feelNoPain}} maximum Pain</p>{{/if}}
      <p class="miko-hint">Weapons and unarmed attacks are Brutal. May Parry arrows and bolts, Grit against any damage, and use bows with Strength.</p>
    </div>

    <div class="miko-panel">
      <h3>Bushido</h3>
      <textarea class="samurai-code" name="system.bushido.code" placeholder="The ideals this Samurai follows…" {{#if samurai.bushido.abandoned}}disabled{{/if}}>{{samurai.bushido.code}}</textarea>
      <label class="miko-checkbox">
        <input type="checkbox" name="system.bushido.abandoned" {{#if samurai.bushido.abandoned}}checked{{/if}}/>
        Abandoned Bushido
      </label>
      {{#unless samurai.bushido.abandoned}}
      <div class="samurai-infractions">
        <span class="miko-subheading">Infraction (Stress)</span>
        {{#each samurai.infractions as |inf|}}
          <button type="button" class="samurai-infraction" data-severity="{{inf.key}}" title="Gain {{inf.formula}} Stress">{{inf.label}} ({{inf.formula}})</button>
        {{/each}}
      </div>
      <p class="miko-hint">Spend Luck to end a magical compulsion to break your code, or a fear that stops you from following it.</p>
      {{/unless}}
    </div>

    <div class="miko-panel">
      <h3>Advancement</h3>
      <button type="button" class="samurai-advance" {{#unless samurai.canAdvance}}disabled{{/unless}} title="Spend Epiphanies equal to your current Arcane Might"><i class="fas fa-arrow-up"></i> Advance Arcane Might</button>
      <p class="miko-hint">Epiphanies needed: {{samurai.epiphanies.max}}. Granted by the GM for living up to your code or surviving harrowing battles.</p>
      <p class="miko-count"><strong>{{samurai.knownSpirits}}</strong> of {{samurai.expectedSpirits}} Martial Spirits (one per level of Arcane Might).</p>
    </div>
  </div>

  {{!-- ── Kenjutsu ── --}}
  <div class="miko-section miko-list">
    <ol class="items-list">
      <li class="item flexrow items-header">
        <div class="item-name">Kenjutsu</div>
        <div class="miko-col-wide">Cost</div>
        <div class="miko-col-narrow" title="Arcane Might it is performed at">Level</div>
        <div class="miko-col-medium" title="Arcane Might tiers unlocked">Tiers</div>
        <div class="item-controls">
          <a class="item-control item-create" title="Create Kenjutsu" data-type="kenjutsu"><i class="fas fa-plus"></i> New</a>
        </div>
      </li>
      {{#each samurai.kenjutsu as |k|}}
      <li class="item flexrow miko-row {{#unless k.usable}}unusable{{/unless}}" data-item-id="{{k.id}}" {{#unless k.usable}}title="{{k.reasons}}"{{/unless}}>
        <div class="item-name">
          <div class="item-image"><a class="samurai-use" title="Use"><img src="{{k.img}}" width="24" height="24"/></a></div>
          <h4>{{k.name}}</h4>
          {{#if k.prerequisite}}<span class="miko-meta">Requires {{k.prerequisite}}</span>{{/if}}
        </div>
        <div class="miko-col-wide item-prop">{{k.cost}}</div>
        <div class="miko-col-narrow item-prop" {{#if k.capped}}title="Limited by the Arcane Might of the one who taught it"{{/if}}>{{k.level}}{{#if k.capped}}*{{/if}}</div>
        <div class="miko-col-medium item-prop">{{k.tiers}}</div>
        <div class="item-controls">
          <a class="item-control samurai-use" title="Use"><i class="fas fa-bolt"></i></a>
          <a class="item-control item-edit" title="Edit"><i class="fas fa-edit"></i></a>
          <a class="item-control item-delete" title="Delete"><i class="fas fa-trash"></i></a>
        </div>
      </li>
      {{else}}
      <li class="miko-empty">No Kenjutsu. Drag them from the Samurai Kenjutsu compendium.</li>
      {{/each}}
    </ol>
  </div>

  {{!-- ── Martial Spirits ── --}}
  <div class="miko-section miko-list">
    <ol class="items-list">
      <li class="item flexrow items-header">
        <div class="item-name">Martial Spirits</div>
        <div class="miko-col-medium">Cost</div>
        <div class="miko-col-cost" title="Samurai ability roll">Roll</div>
        <div class="item-controls">
          <a class="item-control item-create" title="Create Martial Spirit" data-type="samuraiAbility" data-category="martialSpirit"><i class="fas fa-plus"></i> New</a>
        </div>
      </li>
      {{#each samurai.martialSpirits as |a|}}
        {{> samuraiAbilityRow a=a}}
      {{else}}
      <li class="miko-empty">No Martial Spirits. Drag them from the Samurai Martial Spirits compendium.</li>
      {{/each}}
    </ol>
  </div>

  {{!-- ── Warrior's Presence ── --}}
  <div class="miko-section miko-list">
    <ol class="items-list">
      <li class="item flexrow items-header">
        <div class="item-name">Warrior's Presence <span class="miko-meta">One order per turn</span></div>
        <div class="miko-col-medium">Cost</div>
        <div class="miko-col-cost">Roll</div>
        <div class="item-controls">
          <a class="item-control item-create" title="Create order" data-type="samuraiAbility" data-category="warriorsPresence"><i class="fas fa-plus"></i> New</a>
        </div>
      </li>
      {{#each samurai.orders as |a|}}
        {{> samuraiAbilityRow a=a}}
      {{else}}
      <li class="miko-empty">No orders. Drag them from the Samurai Warrior's Presence compendium.</li>
      {{/each}}
    </ol>
  </div>

  {{!-- ── Dragon Blood and core reference cards (only when present) ── --}}
  {{#if samurai.dragonBlood.length}}
  <div class="miko-section miko-list">
    <ol class="items-list">
      <li class="item flexrow items-header">
        <div class="item-name">Dragon Blood</div>
        <div class="miko-col-medium">Cost</div>
        <div class="miko-col-cost">Roll</div>
        <div class="item-controls"></div>
      </li>
      {{#each samurai.dragonBlood as |a|}}
        {{> samuraiAbilityRow a=a}}
      {{/each}}
    </ol>
  </div>
  {{/if}}

  {{#if samurai.core.length}}
  <div class="miko-section miko-list">
    <ol class="items-list">
      <li class="item flexrow items-header">
        <div class="item-name">Core Rules <span class="miko-meta">Reference; these are applied automatically</span></div>
        <div class="miko-col-medium">Cost</div>
        <div class="miko-col-cost">Roll</div>
        <div class="item-controls"></div>
      </li>
      {{#each samurai.core as |a|}}
        {{> samuraiAbilityRow a=a}}
      {{/each}}
    </ol>
  </div>
  {{/if}}
</div>

{{#*inline "samuraiAbilityRow"}}
<li class="item flexrow miko-row {{#unless a.usable}}unusable{{/unless}}" data-item-id="{{a.id}}" {{#unless a.usable}}title="{{a.reasons}}"{{/unless}}>
  <div class="item-name">
    <div class="item-image"><a class="samurai-use" title="Use"><img src="{{a.img}}" width="24" height="24"/></a></div>
    <h4>{{a.name}}</h4>
    {{#if a.requirement}}<span class="miko-meta">{{a.requirement}}</span>{{/if}}
    {{#if a.limited}}
      <a class="samurai-toggle-used ninja-toggle-used {{#if a.used}}used{{/if}}" title="{{a.frequency}}{{#if a.used}} (used){{/if}}: click to toggle"><i class="fas {{#if a.used}}fa-hourglass-end{{else}}fa-hourglass-start{{/if}}"></i></a>
    {{/if}}
  </div>
  <div class="miko-col-medium item-prop">{{a.cost}}</div>
  <div class="miko-col-cost item-prop">{{a.roll}}</div>
  <div class="item-controls">
    <a class="item-control samurai-use" title="Use"><i class="fas fa-bolt"></i></a>
    <a class="item-control item-edit" title="Edit"><i class="fas fa-edit"></i></a>
    <a class="item-control item-delete" title="Delete"><i class="fas fa-trash"></i></a>
  </div>
</li>
{{/inline}}
