{{!-- Ninja tab. Context is prepared in CasusBelliActorSheet#_prepareNinjaContext. --}}
<div class="ninja-tab-content">

  {{!-- ── Header: Arcane Might, Chakra, exhaustion, potency ── --}}
  <div class="ninja-header-row">
    <div class="attribute tile arcane-might-box">
      <label for="system.arcaneMight" class="resource-label rollable" data-roll-type="attribute" data-key="arcaneMight" data-label="Ninja Ability" data-default-second="agi" title="Ninja ability roll: Agility + Arcane Might">Arcane Might</label>
      <input type="text" name="system.arcaneMight" value="{{system.arcaneMight}}" data-dtype="Number"/>
    </div>

    <div class="tracker-box chakra-box {{#if ninja.exhausted}}exhausted{{/if}}">
      <label for="system.chakra.value" class="resource-label">Chakra</label>
      <div class="resource-content">
        <input type="text" name="system.chakra.value" value="{{ninja.chakra.value}}" data-dtype="Number"/>
        <span>/</span>
        <input type="text" name="system.chakra.max" value="{{ninja.chakra.max}}" data-dtype="Number" readonly/>
      </div>
    </div>

    <div class="tracker-box exhaustion-box {{#if ninja.exhausted}}exhausted{{/if}}" title="Weeks of Chakra exhaustion remaining">
      <label for="system.chakraExhaustion.weeks" class="resource-label">Exhaustion (weeks)</label>
      <input type="text" name="system.chakraExhaustion.weeks" value="{{system.chakraExhaustion.weeks}}" data-dtype="Number"/>
    </div>

    <div class="tracker-box potency-box">
      <label for="system.bloodlinePotency" class="resource-label">Bloodline Potency</label>
      <select name="system.bloodlinePotency">
        {{selectOptions ninja.potencies selected=system.bloodlinePotency}}
      </select>
    </div>
  </div>

  {{#if ninja.potencyNote}}<p class="ninja-hint">{{ninja.potencyNote}}</p>{{/if}}
  {{#if ninja.exhausted}}
    <p class="ninja-warning">
      <i class="fas fa-exclamation-triangle"></i>
      {{#if ninja.sealedExhaustion}}
        Chakra Seal: you are in a constant state of Chakra exhaustion unless you draw on the creature within.
      {{else}}
        Chakra exhaustion: Chakra cannot rise above zero, ninja skill rolls automatically fail, and physical attributes are halved.
      {{/if}}
    </p>
  {{/if}}

  {{!-- ── Skills, affinities, surge ── --}}
  <div class="ninja-panels">
    <div class="ninja-panel">
      <h3>Ninja Skills</h3>
      {{#each ninja.skills as |skill|}}
        <div class="ninja-skill {{#if skill.locked}}locked{{/if}}">
          {{#if skill.locked}}
            <label title="You lack knowledge of this area.">{{skill.label}} <i class="fas fa-lock"></i></label>
          {{else}}
            <label class="resource-label rollable" data-roll-type="ninja-skill" data-key="{{skill.key}}" title="Roll {{skill.label}} + Agility">{{skill.label}}</label>
          {{/if}}
          <input type="text" name="system.ninjaSkills.{{skill.key}}.value" value="{{skill.value}}" data-dtype="Number" {{#if skill.locked}}disabled{{/if}}/>
          {{#if skill.boosted}}<span class="ninja-effective" title="Divine Lineage: equal to your highest ninja skill">({{skill.total}})</span>{{/if}}
        </div>
      {{/each}}
    </div>

    <div class="ninja-panel">
      <h3>Elemental Affinities</h3>
      {{#each ninja.affinities as |affinity|}}
        <label class="ninja-affinity {{#if affinity.granted}}granted{{/if}}">
          <input type="checkbox" name="system.affinities.{{affinity.key}}" {{#if affinity.checked}}checked{{/if}}/>
          {{affinity.label}}
          {{#if affinity.granted}}<span class="ninja-effective" title="Granted by Divine Lineage">(Divine Lineage)</span>{{/if}}
        </label>
      {{/each}}
    </div>

    <div class="ninja-panel">
      <h3>Chakra Surge</h3>
      <p class="ninja-hint">To surge on a roll, tick Chakra Surge in the roll dialog. Other uses cost {{ninja.surgeCost}} Chakra:</p>
      <button type="button" class="ninja-surge" data-mode="speed"><i class="fas fa-running"></i> Speed</button>
      <button type="button" class="ninja-surge" data-mode="jump"><i class="fas fa-arrow-up"></i> Jump</button>
      <button type="button" class="ninja-surge" data-mode="armor"><i class="fas fa-shield-alt"></i> Armor (Reaction)</button>
    </div>
  </div>

  {{!-- ── Bloodline ── --}}
  <div class="ninja-section ninja-bloodline">
    <div class="ninja-section-header">
      <h3>Bloodline</h3>
      {{#unless ninja.bloodline}}
        <a class="item-control item-create" data-type="bloodline" title="Create a bloodline"><i class="fas fa-plus"></i> New Bloodline</a>
      {{/unless}}
    </div>

    {{#if ninja.bloodline}}
      {{#with ninja.bloodline as |bl|}}
      <div class="item ninja-bloodline-card" data-item-id="{{bl.id}}">
        <div class="ninja-bloodline-title">
          <img src="{{bl.img}}" width="32" height="32"/>
          <div>
            <h4>{{bl.name}}</h4>
            <span class="ninja-meta">{{bl.label}}</span>
          </div>
          <div class="item-controls">
            <a class="item-control item-use" title="Post to chat"><i class="fas fa-comment"></i></a>
            <a class="item-control item-edit" title="Edit"><i class="fas fa-edit"></i></a>
            <a class="item-control item-delete" title="Delete"><i class="fas fa-trash"></i></a>
          </div>
        </div>

        <div class="ninja-bloodline-controls">
          {{#if bl.canManifest}}
            <button type="button" class="ninja-manifest {{#if bl.active}}active{{/if}}">
              <i class="fas fa-eye"></i> {{#if bl.active}}Manifested{{else}}Manifest{{/if}}
            </button>
          {{/if}}

          {{#if bl.stageLabel}}
            <div class="ninja-stage-track">
              <span class="ninja-stage-label">{{bl.stageLabel}}: <strong>{{bl.stage}}</strong></span>
              {{#each bl.stages as |s|}}
                <span class="ninja-stage-pip {{#if s.reached}}reached{{/if}}" title="{{s.name}}">{{s.stage}}</span>
              {{/each}}
              {{#if bl.canAdjustStage}}
                <button type="button" class="ninja-stage" data-delta="-1" title="Decrease"><i class="fas fa-minus"></i></button>
                <button type="button" class="ninja-stage" data-delta="1" title="Increase"><i class="fas fa-plus"></i></button>
              {{/if}}
            </div>
          {{/if}}

          {{#if bl.isEightGates}}
            <button type="button" class="ninja-open-gate" {{#if bl.gatesSpent}}disabled{{/if}}><i class="fas fa-door-open"></i> Open Next Gate</button>
            <button type="button" class="ninja-close-gates" {{#unless bl.stage}}disabled{{/unless}}><i class="fas fa-door-closed"></i> Close Gates</button>
            {{#if bl.gatesSpent}}<span class="ninja-hint">The Gates cannot be opened again until you rest.</span>{{/if}}
          {{/if}}
        </div>

        {{#if bl.isJinchuriki}}
          {{#if bl.needsFlaw}}
            <p class="ninja-warning"><i class="fas fa-exclamation-triangle"></i> Choose at least one flaw.</p>
          {{/if}}
          {{#if bl.drewChakra}}
            <p class="ninja-warning"><i class="fas fa-fire"></i> Chakra was drawn from the creature this scene: a Critical internal injury follows at the end of the scene.</p>
          {{/if}}
          <div class="ninja-flaws">
            <h4>Flaws</h4>
            {{#each bl.flaws as |flaw|}}
              <label class="ninja-flaw" title="{{flaw.description}}">
                <input type="checkbox" class="ninja-flaw-toggle" data-flaw="{{flaw.key}}" {{#if flaw.checked}}checked{{/if}}/>
                {{flaw.label}}
              </label>
            {{/each}}
          </div>
        {{/if}}
      </div>
      {{/with}}
    {{else}}
      <p class="ninja-empty">No bloodline. Drag one from the Ninja Bloodlines compendium.</p>
    {{/if}}
  </div>

  {{!-- ── Techniques by category ── --}}
  {{#each ninja.techniqueGroups as |group|}}
  <div class="ninja-section ninja-techniques">
    <ol class="items-list">
      <li class="item flexrow items-header">
        <div class="item-name">{{group.label}}</div>
        <div class="ninja-col-rank">Rank</div>
        <div class="ninja-col-element">Element</div>
        <div class="ninja-col-cost">Chakra</div>
        <div class="ninja-col-roll">Roll</div>
        <div class="item-controls">
          {{#unless group.locked}}
          <a class="item-control item-create" title="Create technique" data-type="technique" data-category="{{group.key}}"
            {{#if (eq group.key "bloodline")}}data-bloodline="{{@root.ninja.bloodline.key}}"{{/if}}>
            <i class="fas fa-plus"></i> New
          </a>
          {{/unless}}
        </div>
      </li>
      {{#each group.techniques as |tech|}}
      <li class="item flexrow ninja-technique {{#unless tech.usable}}unusable{{/unless}}" data-item-id="{{tech.id}}" {{#unless tech.usable}}title="{{tech.reasons}}"{{/unless}}>
        <div class="item-name">
          <div class="item-image">
            <a class="ninja-use-technique" title="Use technique"><img src="{{tech.img}}" width="24" height="24"/></a>
          </div>
          <h4>{{tech.name}}</h4>
          {{#if tech.requirement}}<span class="ninja-meta">{{tech.requirement}}</span>{{/if}}
          {{#if tech.limited}}
            <a class="ninja-toggle-used {{#if tech.used}}used{{/if}}" title="{{tech.frequency}}{{#if tech.used}} (used){{/if}}: click to toggle"><i class="fas {{#if tech.used}}fa-hourglass-end{{else}}fa-hourglass-start{{/if}}"></i></a>
          {{/if}}
        </div>
        <div class="ninja-col-rank item-prop">{{tech.rank}}</div>
        <div class="ninja-col-element item-prop">{{tech.element}}</div>
        <div class="ninja-col-cost item-prop">{{tech.cost}}</div>
        <div class="ninja-col-roll item-prop">{{tech.roll}}</div>
        <div class="item-controls">
          <a class="item-control ninja-use-technique" title="Use"><i class="fas fa-bolt"></i></a>
          <a class="item-control ninja-toggle-training" title="Move to training"><i class="fas fa-graduation-cap"></i></a>
          <a class="item-control item-edit" title="Edit"><i class="fas fa-edit"></i></a>
          <a class="item-control item-delete" title="Delete"><i class="fas fa-trash"></i></a>
        </div>
      </li>
      {{else}}
      <li class="ninja-empty">{{#if group.locked}}You lack knowledge of this area.{{else}}No techniques.{{/if}}</li>
      {{/each}}
    </ol>
  </div>
  {{/each}}

  {{!-- ── Training ── --}}
  <div class="ninja-section ninja-training">
    <ol class="items-list">
      <li class="item flexrow items-header">
        <div class="item-name">In Training</div>
        <div class="ninja-col-rank">Rank</div>
        <div class="ninja-col-progress">Progress</div>
        <div class="item-controls"></div>
      </li>
      {{#each ninja.training as |tech|}}
      <li class="item flexrow" data-item-id="{{tech.id}}">
        <div class="item-name">
          <div class="item-image"><img src="{{tech.img}}" width="24" height="24"/></div>
          <h4>{{tech.name}}</h4>
        </div>
        <div class="ninja-col-rank item-prop">{{tech.rank}}</div>
        <div class="ninja-col-progress item-prop">
          {{#if (eq tech.learningCost null)}}
            Roleplay only
          {{else}}
            <div class="ninja-progress-bar" title="{{tech.progress}} / {{tech.learningCost}}"><span style="width: {{tech.progressPercent}}%"></span></div>
            <span>{{tech.progress}} / {{#if tech.learningCost}}{{tech.learningCost}}{{else}}1 week{{/if}}</span>
          {{/if}}
        </div>
        <div class="item-controls">
          <a class="item-control ninja-train" title="Train one week"><i class="fas fa-dumbbell"></i></a>
          <a class="item-control ninja-toggle-training" title="Mark as learned"><i class="fas fa-check"></i></a>
          <a class="item-control item-edit" title="Edit"><i class="fas fa-edit"></i></a>
          <a class="item-control item-delete" title="Delete"><i class="fas fa-trash"></i></a>
        </div>
      </li>
      {{else}}
      <li class="ninja-empty">Nothing in training. Use <i class="fas fa-graduation-cap"></i> on a technique to start training it.</li>
      {{/each}}
    </ol>

    <div class="ninja-learning-reference">
      <span><strong>Progress per week:</strong> {{ninja.learning.progressPerWeek}} (Arcane Might, plus a teacher's)</span>
      <table>
        <tr><th>Rank</th>{{#each ninja.learning.ranks as |r|}}<th>{{r.rank}}</th>{{/each}}</tr>
        <tr><td>Cost</td>{{#each ninja.learning.ranks as |r|}}<td>{{r.cost}}</td>{{/each}}</tr>
        <tr><td>Min. Arcane Might</td>{{#each ninja.learning.ranks as |r|}}<td>{{r.minArcaneMight}}</td>{{/each}}</tr>
      </table>
      <span class="ninja-hint">Starting progress: {{#each ninja.learning.starting as |s|}}AM {{s.arcaneMight}}: {{s.points}} ({{s.ranks}}){{#unless @last}} · {{/unless}}{{/each}}. A ninja at Arcane Might III starts with 240.</span>
    </div>
  </div>
</div>
