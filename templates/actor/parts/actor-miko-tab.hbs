{{!-- Miko tab. Context is prepared in CasusBelliActorSheet#_prepareMikoContext. --}}
<div class="miko-tab-content">

  {{!-- ── Header: Arcane Might, Spiritualism, Unmei, tradition (centered) ── --}}
  <div class="miko-header-row">
    <div class="miko-tile miko-tile-small">
      <label for="system.arcaneMight" class="resource-label">Arcane Might</label>
      <input type="text" name="system.arcaneMight" value="{{system.arcaneMight}}" data-dtype="Number"/>
    </div>

    <div class="miko-tile miko-tile-small">
      <label for="system.spiritualism.value" class="resource-label rollable miko-casting-roll" data-label="Spiritualism" title="Casting roll: Spiritualism + Will">Spiritualism</label>
      <input type="text" name="system.spiritualism.value" value="{{system.spiritualism.value}}" data-dtype="Number"/>
    </div>

    {{#if miko.beloved}}
    <div class="miko-tile miko-tile-pair miko-kami" title="Beloved Above All: Unmei are paid for with the Kami's wound (1 Pain and 1 Stress each)">
      <label class="resource-label">Kami's Wound</label>
      <span class="miko-kami-value">{{#if miko.kamiWound}}{{miko.kamiWound.pain}} Pain{{else}}None{{/if}}</span>
    </div>
    {{else}}
    <div class="miko-tile miko-tile-pair">
      <label for="system.unmei.value" class="resource-label" title="Spend up to two on a roll for one automatic success each">Unmei</label>
      <div class="resource-content">
        <input type="text" name="system.unmei.value" value="{{system.unmei.value}}" data-dtype="Number"/>
        <span>/</span>
        <input type="text" name="system.unmei.max" value="{{system.unmei.max}}" data-dtype="Number" readonly/>
      </div>
    </div>
    {{/if}}

    <div class="miko-tile miko-tile-select">
      <label for="system.tradition" class="resource-label">Tradition</label>
      <select name="system.tradition">
        {{selectOptions miko.traditions selected=system.tradition}}
      </select>
    </div>
  </div>

  {{!-- ── Panels: Spirit Ward, Talisman slots, Favor ── --}}
  <div class="miko-panels">
    <div class="miko-panel">
      <h3>Spirit Ward</h3>
      <button type="button" class="miko-casting-roll" data-label="Spirit Ward"><i class="fas fa-shield-alt"></i> Defend (Spiritualism + Will)</button>
      <p class="miko-hint">Wins ties. Protects against magic{{#if miko.wardPhysical}} and physical attacks{{/if}}; replaces any other defense.</p>
      {{#if miko.wardHasHp}}
        <div class="miko-inline-field">
          <label for="system.spiritWard.value">Ward HP</label>
          <input type="text" name="system.spiritWard.value" value="{{system.spiritWard.value}}" data-dtype="Number"/>
          <span>/ {{system.spiritWard.max}}</span>
        </div>
      {{/if}}
      {{#if miko.isHarai}}<p class="miko-hint">Spellblade: natural armor {{miko.naturalArmor}} while wearing no armor{{#if miko.wearingArmor}} (lost: armor equipped){{else}} (included in the armor tracker){{/if}}.</p>{{/if}}
    </div>

    <div class="miko-panel">
      <h3>Talisman Slots</h3>
      <p class="miko-count {{#if miko.slotsOver}}over{{/if}}"><strong>{{miko.slots.used}}</strong> / {{miko.slots.max}} in use</p>
      {{#if miko.beloved}}
        <p class="miko-hint">Beloved Above All: one Talisman. Each one beyond it costs 1 Pain and 1 Stress, and can be etched after a minute of downtime.</p>
      {{else}}
      <div class="miko-inline-field">
        <label for="system.talismanSlotBonus" title="Extra slots from Inori such as Talisman Master">Bonus slots</label>
        <input type="text" name="system.talismanSlotBonus" value="{{system.talismanSlotBonus}}" data-dtype="Number"/>
      </div>
      {{/if}}
      <p class="miko-hint">Talismans known: {{miko.knownTalismans}} of {{miko.expectedTalismans}} (two, plus one per increase in Arcane Might).</p>
    </div>

    <div class="miko-panel">
      <h3>Favor</h3>
      <div class="miko-inline-field miko-favor">
        <label for="system.favor.value"></label>
        <input type="text" name="system.favor.value" value="{{system.favor.value}}" data-dtype="Number"/>
        <span>/ {{system.favor.max}}</span>
      </div>
      {{#if miko.kamiWound}}
      <button type="button" class="miko-reduce-kami-wound" title="Instant action: reduce the Kami's wound by one Pain"><i class="fas fa-heart"></i> Ease the Kami's wound ({{miko.restFavorCost}} Favor)</button>
      {{/if}}
      <span class="miko-subheading">Once per rest</span>
      {{#unless miko.beloved}}
      <button type="button" class="miko-rest-favor" data-kind="unmei" {{#if miko.mikoRest.unmeiRestored}}disabled{{/if}}><i class="fas fa-star"></i> Restore all Unmei ({{miko.restFavorCost}} Favor)</button>
      {{/unless}}
      <button type="button" class="miko-rest-favor" data-kind="reetch" {{#if miko.mikoRest.reetched}}disabled{{/if}}><i class="fas fa-pen-nib"></i> Etch a new set of Talismans ({{miko.restFavorCost}} Favor)</button>
      <label class="miko-checkbox">
        <input type="checkbox" name="system.wieldsMiasma" {{#if system.wieldsMiasma}}checked{{/if}}/>
        Wields Miasma
      </label>
    </div>
  </div>

  {{!-- ── Abilities ── --}}
  <div class="miko-section miko-list">
    <ol class="items-list">
      <li class="item flexrow items-header">
        <div class="item-name">Abilities ({{miko.traditionLabel}})</div>
        <div class="miko-col-wide">Tradition</div>
        <div class="miko-col-narrow" title="Arcane Might required">AM</div>
        <div class="item-controls">
          <a class="item-control item-create" title="Create ability" data-type="mikoAbility" data-tradition="{{miko.tradition}}"><i class="fas fa-plus"></i> New</a>
        </div>
      </li>
      {{#each miko.abilities as |ability|}}
      <li class="item flexrow miko-row {{#unless ability.usable}}unusable{{/unless}}" data-item-id="{{ability.id}}" {{#unless ability.usable}}title="{{ability.reasons}}"{{/unless}}>
        <div class="item-name">
          <div class="item-image"><img src="{{ability.img}}" width="24" height="24"/></div>
          <h4>{{ability.name}}</h4>
        </div>
        <div class="miko-col-wide item-prop">{{ability.tradition}}</div>
        <div class="miko-col-narrow item-prop">{{ability.minArcaneMight}}</div>
        <div class="item-controls">
          <a class="item-control item-use" title="Post to chat"><i class="fas fa-comment"></i></a>
          <a class="item-control item-edit" title="Edit"><i class="fas fa-edit"></i></a>
          <a class="item-control item-delete" title="Delete"><i class="fas fa-trash"></i></a>
        </div>
      </li>
      {{else}}
      <li class="miko-empty">No abilities. Drag them from the Miko Abilities compendium.</li>
      {{/each}}
    </ol>
  </div>

  {{!-- ── Talismans ── --}}
  <div class="miko-section miko-list">
    <ol class="items-list">
      <li class="item flexrow items-header">
        <div class="item-name">Talismans</div>
        <div class="miko-col-medium" title="Ofuda currently etched">Etched</div>
        <div class="miko-col-xwide">Use</div>
        <div class="item-controls">
          <a class="item-control item-create" title="Create talisman" data-type="talisman"><i class="fas fa-plus"></i> New</a>
        </div>
      </li>
      {{#each miko.talismans as |tal|}}
      <li class="item flexrow" data-item-id="{{tal.id}}">
        <div class="item-name">
          <div class="item-image"><img src="{{tal.img}}" width="24" height="24"/></div>
          <h4>{{tal.name}}</h4>
        </div>
        <div class="miko-col-medium item-prop miko-etch-cell">
          {{#if tal.hasOfuda}}
            <a class="miko-etch" data-delta="-1" title="Erase an Ofuda"><i class="fas fa-minus"></i></a>
            <strong>{{tal.prepared}}</strong>
            <a class="miko-etch" data-delta="1" title="Etch an Ofuda"><i class="fas fa-plus"></i></a>
          {{/if}}
        </div>
        <div class="miko-col-xwide item-prop miko-use-cell">
          {{#if tal.hasOmamori}}<button type="button" class="miko-use-talisman" data-variant="omamori" title="Lesser variant: free to use">Omamori</button>{{/if}}
          {{#if tal.hasOfuda}}<button type="button" class="miko-use-talisman" data-variant="ofuda" title="Greater variant: uses one etched Ofuda" {{#unless tal.prepared}}disabled{{/unless}}>Ofuda</button>{{/if}}
        </div>
        <div class="item-controls">
          <a class="item-control miko-toggle-training" title="Move to training"><i class="fas fa-graduation-cap"></i></a>
          <a class="item-control item-edit" title="Edit"><i class="fas fa-edit"></i></a>
          <a class="item-control item-delete" title="Delete"><i class="fas fa-trash"></i></a>
        </div>
      </li>
      {{else}}
      <li class="miko-empty">No talismans. Drag them from the Miko Talismans compendium.</li>
      {{/each}}
    </ol>

    {{#if miko.training.length}}
    <ol class="items-list">
      <li class="item flexrow items-header">
        <div class="item-name">In Training</div>
        <div class="miko-col-xwide">Progress</div>
        <div class="item-controls"></div>
      </li>
      {{#each miko.training as |tal|}}
      <li class="item flexrow" data-item-id="{{tal.id}}">
        <div class="item-name">
          <div class="item-image"><img src="{{tal.img}}" width="24" height="24"/></div>
          <h4>{{tal.name}}</h4>
        </div>
        <div class="miko-col-xwide item-prop">
          <div class="miko-progress-bar" title="{{tal.progress}} / {{tal.learningCost}}"><span style="width: {{tal.progressPercent}}%"></span></div>
          <span>{{tal.progress}} / {{tal.learningCost}}</span>
        </div>
        <div class="item-controls">
          <a class="item-control miko-train" title="Train one week"><i class="fas fa-dumbbell"></i></a>
          <a class="item-control miko-toggle-training" title="Mark as learned"><i class="fas fa-check"></i></a>
          <a class="item-control item-edit" title="Edit"><i class="fas fa-edit"></i></a>
          <a class="item-control item-delete" title="Delete"><i class="fas fa-trash"></i></a>
        </div>
      </li>
      {{/each}}
    </ol>
    {{/if}}
  </div>

  {{!-- ── Kannagara ── --}}
  <div class="miko-section miko-list">
    <ol class="items-list">
      <li class="item flexrow items-header">
        <div class="item-name">Kannagara <span class="miko-meta {{#if miko.capacityOver}}over{{/if}}">Maintenance {{miko.capacity.used}} / {{miko.capacity.max}}</span></div>
        <div class="miko-col-narrow" title="Arcane Might required to perform">AM</div>
        <div class="miko-col-cost">Favor</div>
        <div class="miko-col-medium" title="Maintenance capacity used while active">Maint.</div>
        <div class="item-controls">
          <a class="item-control item-create" title="Create Kannagara" data-type="rite" data-kind="kannagara"><i class="fas fa-plus"></i> New</a>
        </div>
      </li>
      {{#each miko.kannagara as |rite|}}
        {{> riteRow rite=rite}}
      {{else}}
      <li class="miko-empty">No Kannagara. Drag them from the Miko Rites compendium.</li>
      {{/each}}
    </ol>
  </div>

  {{!-- ── Miasma ── --}}
  {{#if miko.wieldsMiasma}}
  <div class="miko-section miko-list">
    <ol class="items-list">
      <li class="item flexrow items-header">
        <div class="item-name">Miasma <span class="miko-meta">Each active Miasma holds a Talisman slot</span></div>
        <div class="miko-col-narrow" title="Arcane Might required to perform">AM</div>
        <div class="miko-col-cost">Favor</div>
        <div class="miko-col-medium" title="Maintenance capacity used while active">Maint.</div>
        <div class="item-controls">
          <a class="item-control item-create" title="Create Miasma" data-type="rite" data-kind="miasma"><i class="fas fa-plus"></i> New</a>
        </div>
      </li>
      {{#each miko.miasma as |rite|}}
        {{> riteRow rite=rite}}
      {{else}}
      <li class="miko-empty">No Miasma. Drag them from the Miko Rites compendium.</li>
      {{/each}}
    </ol>
  </div>
  {{/if}}
</div>

{{#*inline "riteRow"}}
<li class="item flexrow miko-row {{#unless rite.usable}}unusable{{/unless}}" data-item-id="{{rite.id}}" {{#unless rite.usable}}title="{{rite.reasons}}"{{/unless}}>
  <div class="item-name">
    <div class="item-image"><img src="{{rite.img}}" width="24" height="24"/></div>
    <h4>{{rite.name}}</h4>
    {{#if rite.tags}}<span class="miko-meta">{{rite.tags}}</span>{{/if}}
  </div>
  <div class="miko-col-narrow item-prop">{{rite.minArcaneMight}}</div>
  <div class="miko-col-cost item-prop" title="{{rite.costTitle}}">{{rite.cost}}</div>
  <div class="miko-col-medium item-prop" title="{{rite.maintenanceTitle}}">{{rite.maintenance}}</div>
  <div class="item-controls">
    <a class="item-control miko-perform-rite" title="Perform (spend Favor)"><i class="fas fa-bolt"></i></a>
    <a class="item-control miko-toggle-active {{#if rite.active}}active{{/if}}" title="{{#if rite.active}}Active: click to end{{else}}Inactive: click to mark active{{/if}}"><i class="fas {{#if rite.active}}fa-toggle-on{{else}}fa-toggle-off{{/if}}"></i></a>
    <a class="item-control item-edit" title="Edit"><i class="fas fa-edit"></i></a>
    <a class="item-control item-delete" title="Delete"><i class="fas fa-trash"></i></a>
  </div>
</li>
{{/inline}}
